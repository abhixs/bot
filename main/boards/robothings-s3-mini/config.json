{
    "type": "robothings-s3-mini",
    "target": "esp32s3",
    "builds": [
        {
            "name": "robothings-s3-mini",
            "sdkconfig_append": [
                "CONFIG_OLED_SSD1306_128X64=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y",
                "CONFIG_ESPTOOLPY_FLASHMODE_DIO=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/4m.csv\"",
                "CONFIG_SPIRAM_MODE_QUAD=y",
                "CONFIG_LV_MEM_SIZE_KILOBYTES=256",
                "CONFIG_SEND_WAKE_WORD_DATA=n",
                "CONFIG_WAKE_WORD_DETECTION_IN_LISTENING=y",
                "CONFIG_AFE_AEC_SPEECH_RECOGNITION=y",
                "CONFIG_AFE_NOISE_SUPPRESSION=y",
                "CONFIG_AFE_OUTPUT_GAIN_PERCENT=200"
            ]
        },
        {
            "name": "robothings-s3-mini-sh1106",
            "sdkconfig_append": [
                "CONFIG_OLED_SH1106_128X64=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y",
                "CONFIG_ESPTOOLPY_FLASHMODE_DIO=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/4m.csv\"",
                "CONFIG_SPIRAM_MODE_QUAD=y",
                "CONFIG_LV_MEM_SIZE_KILOBYTES=256",
                "CONFIG_SEND_WAKE_WORD_DATA=n",
                "CONFIG_WAKE_WORD_DETECTION_IN_LISTENING=y",
                "CONFIG_AFE_AEC_SPEECH_RECOGNITION=y",
                "CONFIG_AFE_NOISE_SUPPRESSION=y",
                "CONFIG_AFE_OUTPUT_GAIN_PERCENT=200"
            ]
        }
    ]
}
